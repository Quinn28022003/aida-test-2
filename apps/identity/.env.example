# App runtime (PORT is for Next.js only — not validated by @aida/config)
PORT=3006

# Default post-auth destination when returnTo is missing or invalid
NEXT_PUBLIC_CHAT_DOMAIN=http://localhost:3000
# Comma-separated product app origins allowed for returnTo redirects
NEXT_PUBLIC_ALLOWED_RETURN_TO_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
