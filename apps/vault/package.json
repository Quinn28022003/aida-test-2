{
  "name": "@aida/vault",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -- next dev",
    "build": "next build",
    "start": "dotenv -- next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests --config vitest.config.ts",
    "test:coverage": "vitest run --passWithNoTests --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@aida/api-client": "workspace:^",
    "@aida/config": "workspace:^",
    "@aida/contracts": "workspace:^",
    "@aida/db": "workspace:^",
    "@aida/ui": "workspace:^",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.90.21",
    "next": "^16.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.2"
  }
}
