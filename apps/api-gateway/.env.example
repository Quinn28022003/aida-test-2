# App runtime
PORT=3002
# Optional — public API origin for Swagger; same as chat/vault NEXT_PUBLIC_API_GATEWAY_URL (defaults to http://localhost:PORT)
# API_GATEWAY_DOMAIN=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Supabase and database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Same value as apps/chat NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (required for user JWT routes)
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# JWKS is fetched from SUPABASE_URL at startup (Settings → JWT Keys → JWT Signing Keys in Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/aida

# AWS credentials
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Application secrets
APP_ENCRYPTION_KEY=your-app-encryption-key

# Email
RESEND_API_KEY=your-resend-api-key
SUPPORT_EMAIL_FROM=support@example.com

# Bedrock models
BEDROCK_MODEL_ROUTER=arn:aws:bedrock:ap-southeast-2:182399702812:inference-profile/global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_DOMAIN_DEFAULT=arn:aws:bedrock:ap-southeast-2:182399702812:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_SUMMARIZER=arn:aws:bedrock:ap-southeast-2:182399702812:inference-profile/global.anthropic.claude-haiku-4-5-20251001-v1:0

# Logging and debug
LOG_LEVEL=info
DEBUG=false
AIDA_DEBUG_TRACE=false
