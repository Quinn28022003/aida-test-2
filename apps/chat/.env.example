# App runtime (PORT is for Next.js only — not validated by @aida/config)
PORT=3000
NEXT_PUBLIC_IDENTITY_DOMAIN=http://localhost:3006
NEXT_PUBLIC_VAULT_DOMAIN=http://localhost:3001
# Must match apps/api-gateway PORT (default 3002 in api-gateway/.env.example)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3002

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
